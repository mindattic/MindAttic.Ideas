@attribute [Authorize(Policy = MaPolicies.Admin)]
@using MindAttic.Ideas.Core.Sites
@using MindAttic.Ideas.Core.Data
@using Microsoft.EntityFrameworkCore
@inject IPackageRegistryService Registry
@inject ISiteResolver SiteResolver
@inject IDbContextFactory<CmsDbContext> DbFactory
@inject NavigationManager Nav
@inject IHttpContextAccessor Http

@* Packages panel — browses the .idea blobs this SITE can see: the shared ones plus its own (MAI-A36).
   The download link hits the admin-protected /_ideas/packages/{category}/{key}/{version} endpoint, or
   its /_ideas/sites/{id}/… sibling for a package a single site owns. *@

@if (packages is null)
{
    <p>Loading…</p>
}
else if (!packages.Any())
{
    <p class="admin-empty">No .idea packages installed yet. Use the <a href="/admin/upload">Upload</a> tab to install one.</p>
}
else
{
    <table class="admin-table">
        <thead>
            <tr>
                <th>Category</th>
                <th>Key</th>
                <th>Ver</th>
                <th>Name</th>
                <th>Installed</th>
                <th>SHA-256</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in packages)
            {
                <tr class="@(!p.Enabled ? "row-off" : "") @(p.IsActiveVersion ? "" : "row-dim")">
                    <td>@p.Category</td>
                    <td>@p.Key</td>
                    <td>V@p.Version</td>
                    <td>@p.DisplayName</td>
                    <td><span title="@p.InstalledUtc.ToString("O")">@p.InstalledUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span></td>
                    <td><code class="admin-hash">@(p.Sha256.Length >= 12 ? p.Sha256[..12] + "…" : p.Sha256)</code></td>
                    <td>
                        @if (!string.IsNullOrEmpty(p.BlobPath))
                        {
                            @* A site-owned package lives under its own prefix; the shared route below is untouched. *@
                            <a class="admin-link" download
                               href="@(p.SiteId is int s
                                       ? $"/_ideas/sites/{s}/packages/{p.Category}/{p.Key}/{p.Version}"
                                       : $"/_ideas/packages/{p.Category}/{p.Key}/{p.Version}")">Download</a>
                        }
                        @if (p.SiteId is not null)  { <span class="admin-badge">this site only</span> }
                        @if (!p.IsActiveVersion) { <span class="admin-badge">superseded</span> }
                        @if (!p.Enabled)         { <span class="admin-badge">disabled</span>   }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private IReadOnlyList<PackageSummary>? packages;

    protected override async Task OnInitializedAsync()
    {
        var requestHost = RequestSite.HostOf(Nav.BaseUri) ?? Http.HttpContext?.Request.Host.Value;
        await using var db = await DbFactory.CreateDbContextAsync();
        var site = await SiteResolver.ResolveAsync(requestHost, db);
        packages = await Registry.ListAsync(site?.Id);
    }
}
