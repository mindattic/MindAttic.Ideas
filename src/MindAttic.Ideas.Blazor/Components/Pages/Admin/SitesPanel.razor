@attribute [Authorize(Policy = MaPolicies.Admin)]
@inject ISiteAdminService SitesSvc

@* Sites panel — one deployment, many domains (MAI-A35). A site's HostBindings decide which requests
   land on it; the default site answers everything unclaimed, which is why a single-site install needs
   no bindings at all and behaves exactly as it always has. *@

<div class="admin-two-pane">
    <div class="admin-list">
        <button class="admin-new" @onclick="StartNew">+ New Site</button>
        @foreach (var s in sites)
        {
            <div class="admin-item @(editing?.Id == s.Id ? "active" : "")" @onclick="() => Edit(s)">
                <span class="admin-item-name">@s.Name @(s.IsDefault ? "★" : "")</span>
                <span class="admin-sub">
                    @(string.IsNullOrWhiteSpace(s.HostBindings) ? "no bindings — answers unclaimed hosts" : s.HostBindings)
                    · @s.PageCount page@(s.PageCount == 1 ? "" : "s")
                </span>
            </div>
        }
    </div>

    <div class="admin-editor">
        @if (editing is null)
        {
            <p class="admin-empty">Select a site, or create one to serve a second domain from this deployment.</p>
        }
        else
        {
            <div class="admin-editor-head">
                <h2>@(isNew ? "New Site" : editing.Name)</h2>
                <button class="admin-save" @onclick="Save">Save</button>
                @if (!isNew && !editing.IsDefault)
                {
                    <button class="admin-link" @onclick="MakeDefault">Make default</button>
                    <button class="admin-link danger" @onclick="Delete">Delete</button>
                }
            </div>

            @if (!string.IsNullOrEmpty(status))
            {
                <div class="admin-status @(statusBad ? "err" : "ok")">@status</div>
            }

            <label class="admin-area">Key
                <input @bind="editing.Key" placeholder="e.g. ryandebraal" disabled="@(!isNew)" />
                <small>@(isNew ? "Lowercase, stable. Used by import/export and seeding." : "The key is fixed after creation.")</small>
            </label>

            <label class="admin-area">Name
                <input @bind="editing.Name" placeholder="e.g. Ryan DeBraal" />
            </label>

            <label class="admin-area">Host bindings
                <input @bind="editing.HostBindings"
                       placeholder="ryandebraal.com, www.ryandebraal.com, *.ryandebraal.com" />
                <small>
                    Comma-separated. Case-insensitive; the port is ignored unless you name one, so a
                    production binding still matches on localhost. <code>*.example.com</code> covers
                    subdomains but not the apex — bind that explicitly. <code>*</code> catches everything.
                    Leave empty on the default site: it already answers every unclaimed host.
                </small>
            </label>

            <div class="admin-row">
                <label class="admin-area">Default theme
                    <input @bind="editing.DefaultThemeKey" placeholder="e.g. cyberspace" />
                </label>
                <label class="admin-area">Theme version
                    <input type="number" min="1" @bind="editing.DefaultThemeVersion" />
                </label>
            </div>

            @if (editing.IsDefault)
            {
                <p class="admin-hint">★ This is the default site: it answers any hostname no binding claims.</p>
            }
            else if (!isNew)
            {
                @* Showroom mode (MAI-A36). Deliberately absent on the default site: SandboxService.Gate and
                   SiteAdminService both refuse that state, and offering a switch that cannot be thrown reads
                   as a bug. Save the site first — the toggle acts on a row that exists. *@
                <div class="admin-area" style="border:1px dashed #2d7d46;border-radius:6px;padding:.6rem .75rem;">
                    <label class="admin-flags">
                        <input type="checkbox" checked="@editing.IsSandbox"
                               @onchange="e => ToggleSandbox(e.Value is true)" />
                        <strong>Showroom mode</strong> — a disposable sandbox
                    </label>
                    <small>
                        Visitors may author pages and install their own <code>.idea</code> packages here, and
                        see none of it anywhere else. Its content is wiped back to the baseline once nobody
                        has been seen for the grace period below. The default site can never be put into this
                        mode, whatever its row says.
                    </small>
                    @if (editing.IsSandbox)
                    {
                        <div class="admin-row" style="margin-top:.5rem">
                            <label class="admin-area">Reset policy
                                <input @bind="editing.ResetPolicy" placeholder="when-idle" />
                                <small>Empty means never reset.</small>
                            </label>
                            <label class="admin-area">Idle grace (minutes)
                                <input type="number" min="1" @bind="editing.IdleGraceMinutes" />
                            </label>
                        </div>
                        <button class="admin-save" @onclick="SaveSandbox">Save showroom settings</button>
                    }
                </div>
            }
        }

        <div class="admin-editor-head" style="margin-top:1.5rem">
            <h2>Which site answers…?</h2>
        </div>
        <label class="admin-area">Hostname
            <input @bind="probeHost" @bind:event="oninput" placeholder="www.example.com:5199" />
            <small>Resolves a hostname exactly the way an incoming request would.</small>
        </label>
        <button class="admin-save" @onclick="Probe">Resolve</button>
        @if (!string.IsNullOrEmpty(probeResult))
        {
            <div class="admin-status ok">@probeResult</div>
        }
    </div>
</div>

@code {
    private sealed class SiteEdit
    {
        public int Id { get; set; }
        public string Key { get; set; } = "";
        public string Name { get; set; } = "";
        public string HostBindings { get; set; } = "";
        public string DefaultThemeKey { get; set; } = "";
        public int DefaultThemeVersion { get; set; } = 1;
        public bool IsDefault { get; set; }
        public bool IsSandbox { get; set; }
        public string ResetPolicy { get; set; } = "";
        public int IdleGraceMinutes { get; set; } = 10;
    }

    private IReadOnlyList<SiteSummary> sites = [];
    private SiteEdit? editing;
    private bool isNew;
    private string status = "";
    private bool statusBad;
    private string probeHost = "";
    private string probeResult = "";

    protected override async Task OnInitializedAsync() => await Load();
    private async Task Load() => sites = await SitesSvc.ListAsync();

    private void StartNew()
    {
        editing = new SiteEdit();
        isNew = true; status = "";
    }

    private void Edit(SiteSummary s)
    {
        editing = new SiteEdit
        {
            Id = s.Id, Key = s.Key, Name = s.Name, HostBindings = s.HostBindings,
            DefaultThemeKey = s.DefaultThemeKey, DefaultThemeVersion = s.DefaultThemeVersion,
            IsDefault = s.IsDefault,
            IsSandbox = s.IsSandbox, ResetPolicy = s.ResetPolicy ?? "", IdleGraceMinutes = s.IdleGraceMinutes,
        };
        isNew = false; status = "";
    }

    private async Task Save()
    {
        if (editing is null) return;
        var (ok, error) = isNew
            ? await CreateAsync()
            : await SitesSvc.UpdateAsync(editing.Id, editing.Name, editing.HostBindings,
                                         editing.DefaultThemeKey, editing.DefaultThemeVersion);
        statusBad = !ok;
        status = ok ? (isNew ? "Site created." : "Saved.") : (error ?? "Could not save.");
        if (ok)
        {
            isNew = false;
            await Load();
            var saved = sites.FirstOrDefault(s => s.Key == editing.Key);
            if (saved is not null) Edit(saved);
            status = statusBad ? status : "Saved.";
        }
    }

    private async Task<(bool, string?)> CreateAsync()
    {
        var (ok, error, _) = await SitesSvc.CreateAsync(editing!.Key, editing.Name, editing.HostBindings,
                                                        editing.DefaultThemeKey, editing.DefaultThemeVersion);
        return (ok, error);
    }

    /// <summary>Flip Showroom mode. SiteAdminService is the authority on whether the state is legal.</summary>
    private async Task ToggleSandbox(bool on)
    {
        if (editing is null || isNew) return;
        editing.IsSandbox = on;
        await SaveSandbox();
    }

    private async Task SaveSandbox()
    {
        if (editing is null || isNew) return;
        var (ok, error) = await SitesSvc.SetSandboxAsync(
            editing.Id, editing.IsSandbox, editing.ResetPolicy, editing.IdleGraceMinutes);
        statusBad = !ok;
        status = ok
            ? (editing.IsSandbox ? "Showroom mode is on for this site." : "Showroom mode is off.")
            : (error ?? "Could not change showroom mode.");
        await Load();
        var refreshed = sites.FirstOrDefault(x => x.Id == editing.Id);
        if (refreshed is not null) Edit(refreshed);
    }

    private async Task MakeDefault()
    {
        if (editing is null || isNew) return;
        var (ok, error) = await SitesSvc.MakeDefaultAsync(editing.Id);
        statusBad = !ok;
        status = ok ? "Default site changed." : (error ?? "Could not change the default.");
        await Load();
        var refreshed = sites.FirstOrDefault(s => s.Id == editing.Id);
        if (refreshed is not null) Edit(refreshed);
    }

    private async Task Delete()
    {
        if (editing is null || isNew) return;
        var (ok, error) = await SitesSvc.DeleteAsync(editing.Id);
        if (!ok) { status = error ?? "Could not delete."; statusBad = true; return; }
        editing = null; status = ""; statusBad = false;
        await Load();
    }

    private async Task Probe()
    {
        if (string.IsNullOrWhiteSpace(probeHost)) { probeResult = ""; return; }
        var match = await SitesSvc.WhichSiteAsync(probeHost);
        probeResult = match is null
            ? "No sites exist yet."
            : $"\"{probeHost}\" → {match.Name} ({match.Key}){(match.IsDefault ? " — matched as the default site" : "")}";
    }
}
