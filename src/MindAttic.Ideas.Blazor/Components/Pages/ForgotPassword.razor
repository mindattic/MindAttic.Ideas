@page "/forgot-password"
@using Microsoft.AspNetCore.Authorization
@using MindAttic.Authentication.Components
@attribute [AllowAnonymous]

<PageTitle>Forgot password</PageTitle>

<div class="ma-auth-page">
    <h1>Forgot password</h1>
    @* Static-SSR. MaForgotPassword posts to /_ma-auth/reset/request, which is enumeration-safe and always
       redirects to /login?reset=sent. The emailed link points at /account/reset (ResetPassword.razor). *@
    <MaForgotPassword />
    <p><a href="/login">Back to sign in</a></p>
</div>
