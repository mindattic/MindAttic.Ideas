@page "/account/reset"
@using Microsoft.AspNetCore.Authorization
@using MindAttic.Authentication.Components
@attribute [AllowAnonymous]

<PageTitle>Reset password</PageTitle>

<div class="ma-auth-page">
    <h1>Reset password</h1>
    @* Target of the emailed reset link: MindAttic:Auth:Reset:PublicBaseUrl + ResetPath (/account/reset)
       + ?token=. Static-SSR; MaResetPassword posts to /_ma-auth/reset/confirm, which redirects to
       /login?reset=ok on success or back here with ?error=1&token=... *@
    <MaResetPassword Token="@Token" Error="@(Error == 1)" />
</div>

@code {
    [SupplyParameterFromQuery] public string? Token { get; set; }
    [SupplyParameterFromQuery] public int Error { get; set; }
}
