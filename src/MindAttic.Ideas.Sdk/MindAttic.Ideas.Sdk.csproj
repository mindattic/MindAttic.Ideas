<Project Sdk="Microsoft.NET.Sdk">

  <!-- The .idea packer. Turns a built Page/Theme/Component/Control RCL into a `.idea` package
       (a zip: idea.json manifest + lib/ + wwwroot/). Distributed as a dotnet tool: `ma-idea`.
       Identity (Kind, Key, Version) is read by CONVENTION from the entry type's
       namespace/class-name, with optional [Idea]/[IdeaSdkVersion] overrides — via reflection-only
       MetadataLoadContext, so the packer never executes the target assembly. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>MindAttic.Ideas.Sdk</RootNamespace>
    <AssemblyName>MindAttic.Ideas.Sdk</AssemblyName>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>ma-idea</ToolCommandName>
    <PackageId>MindAttic.Ideas.Sdk</PackageId>
    <Version>1.0.0</Version>
    <Description>The .idea packer (ma-idea) for the MindAttic.Ideas CMS. Packs a Page/Theme/Component/Control RCL into a .idea package.</Description>
    <Company>MindAttic</Company>
    <Authors>MindAttic</Authors>
  </PropertyGroup>

  <ItemGroup>
    <!-- The packer + manifest contract + install rules live in the shared Packaging library so the host
         (Core) and this CLI read exactly one implementation. PackageSigner (content signing) lives there
         too, so `ma-idea sign` reuses the exact same Sign/Verify code the host verifies against. -->
    <ProjectReference Include="..\MindAttic.Ideas.Packaging\MindAttic.Ideas.Packaging.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- `ma-idea nupkg`: constructs a valid OPC .nupkg from an already-signed .idea, for publishing to a
         NuGet feed (GitHub Packages). No NuGet.Packaging.Signing — a .idea's own content signature
         (PackageSigner) is independent of NuGet's package-signing feature. -->
    <PackageReference Include="NuGet.Packaging" Version="7.9.0" />
  </ItemGroup>

</Project>
