@namespace MindAttic.Ideas.Plugin.PoweredBy
@inherits PluginBase
@attribute [Idea(DisplayName = "Powered By", Slot = PluginSlot.AfterBody)]

@*  MindAttic.Ideas.Plugin.PoweredBy.V1 — the site footer, and the CMS's own byline.

    Emits a real <footer class="ma-footer pin-when-short">, so the Footer plugin's chrome styles it and
    Plugin.PinFooter pins it to the bottom edge while the page is shorter than the viewport — both by
    class contract, neither required. Activate this alone and it still renders, just without either.

    Content comes from the Host -> Site -> Page setting chain, exactly like NavMenu:
      footer.text    free text (e.g. "© 2026 MindAttic LLC")
      footer.links   "Text=/href;Text=/href"
    The "Powered by" badge is always rendered — advertising the CMS is the whole point of the plugin —
    and points at the Ideas brochure page, which is itself a Component in this CMS.  *@

<link rel="stylesheet" href="/_ideas/Plugin/poweredby/1/poweredby.css" />

<footer class="ma-footer ma-pb @(PinWhenShort ? "pin-when-short" : null) @CssClass" style="@_outerStyle">
    <div class="ma-pb-inner">
        @if (!string.IsNullOrWhiteSpace(_text))
        {
            <span class="ma-pb-text">@_text</span>
        }

        @if (_links.Count > 0)
        {
            <nav class="ma-pb-links" aria-label="Footer">
                @foreach (var (text, href) in _links)
                {
                    <a class="ma-pb-link" href="@href">@text</a>
                }
            </nav>
        }

        <span class="ma-pb-badge">
            @(BadgePrefix ?? "Powered by") <a class="ma-pb-badge-link" href="@_href">@_label</a>
        </span>
    </div>
</footer>

@code {
    // ── Content ─────────────────────────────────────────────────────────────────────────────────
    /// <summary>Footer text. Overrides the "footer.text" site setting.</summary>
    [Parameter, Setting("Footer text", Group = "Content", Order = 1, Copyable = false, Multiline = true, Description = "Overrides the footer.text site setting")]
    public string? Text { get; set; }

    /// <summary>Footer links as "Text=/href;Text=/href". Overrides the "footer.links" site setting.</summary>
    [Parameter, Setting("Footer links", Group = "Content", Order = 2, Copyable = false, Description = "Text=/href;Text=/href (overrides footer.links)")]
    public string? Links { get; set; }

    /// <summary>Where the badge points. Overrides the "poweredby.href" site setting. Default "/ideas".</summary>
    [Parameter, Setting("Badge link", Group = "Content", Order = 3, Copyable = false, Description = "designed: /ideas (overrides poweredby.href)")]
    public string? Href { get; set; }

    /// <summary>Badge wording. Overrides the "poweredby.label" site setting. Default "MindAttic.Ideas".</summary>
    [Parameter, Setting("Badge label", Group = "Content", Order = 4, Copyable = false, Description = "designed: MindAttic.Ideas (overrides poweredby.label)")]
    public string? Label { get; set; }

    [Parameter, Setting("Badge prefix", Group = "Content", Order = 5, Copyable = false, Description = "Words before the badge link (designed: \"Powered by\")")]
    public string? BadgePrefix { get; set; }

    // ── Layout ──────────────────────────────────────────────────────────────────────────────────
    [Parameter, Setting("Padding", Group = "Layout", Order = 1, Description = "designed: 1.25rem 0")] public string? Padding { get; set; }
    [Parameter, Setting("Margin", Group = "Layout", Order = 2, Description = "designed: 3rem above")] public string? Margin { get; set; }
    [Parameter, Setting("Content max width", Group = "Layout", Order = 3, Description = "designed: the theme's --max-width, else 70rem")] public string? MaxWidth { get; set; }
    [Parameter, Setting("Inner padding", Group = "Layout", Order = 4, Description = "designed: 0 1rem")] public string? InnerPadding { get; set; }
    [Parameter, Setting("Gap", Group = "Layout", Order = 5, Description = "Space between text, links and badge (designed: .75rem 1.25rem)")] public string? Gap { get; set; }

    // ── Appearance ──────────────────────────────────────────────────────────────────────────────
    [Parameter, Setting("Font size", Group = "Appearance", Order = 1, Description = "designed: .82rem")] public string? FontSize { get; set; }
    [Parameter, Setting("Text color", Group = "Appearance", Order = 2, Description = "designed: the theme's --muted")] public string? TextColor { get; set; }
    [Parameter, Setting("Accent color", Group = "Appearance", Order = 3, Description = "Link hover color (designed: the theme's --accent)")] public string? AccentColor { get; set; }
    [Parameter, Setting("Border color", Group = "Appearance", Order = 4, Description = "Top rule + badge underline (designed: the theme's --border)")] public string? BorderColor { get; set; }
    [Parameter, Setting("Background", Group = "Appearance", Order = 5, Description = "CSS background (designed: none)")] public string? Background { get; set; }

    // ── Behavior ────────────────────────────────────────────────────────────────────────────────
    [Parameter, Setting("Pin when short", Group = "Behavior", Order = 1, Description = "Carry the pin-when-short class (Plugin.PinFooter pins it while the page is short)")]
    public bool PinWhenShort { get; set; } = true;

    // ── Advanced ────────────────────────────────────────────────────────────────────────────────
    [Parameter, Setting("Extra CSS classes", Group = "Advanced", Order = 1)] public string? CssClass { get; set; }
    [Parameter, Setting("Extra inline style", Group = "Advanced", Order = 2)] public string? CssStyle { get; set; }

    private string _outerStyle => string.Join(";", new[]
    {
        string.IsNullOrEmpty(Padding) ? null : $"padding:{Padding}",
        string.IsNullOrEmpty(Margin) ? null : $"margin:{Margin}",
        Var("--ma-pb-max-width", MaxWidth),
        Var("--ma-pb-inner-padding", InnerPadding),
        Var("--ma-pb-gap", Gap),
        Var("font-size", FontSize),
        Var("--ma-pb-muted", TextColor),
        Var("--ma-pb-accent", AccentColor),
        Var("--ma-pb-border", BorderColor),
        Var("background", Background),
        CssStyle,
    }.Where(s => s is not null));

    private static string? Var(string prop, string? value) => string.IsNullOrWhiteSpace(value) ? null : prop + ":" + value.Trim();

    private string? _text;
    private string _href = "/ideas";
    private string _label = "MindAttic.Ideas";
    private IReadOnlyList<(string Text, string Href)> _links = Array.Empty<(string, string)>();

    protected override void OnParametersSet()
    {
        var site = Context?.Site;
        _text = FirstNonEmpty(Text, site?.GetSetting("footer.text"));
        _href = SafeUrl(FirstNonEmpty(Href, site?.GetSetting("poweredby.href")) ?? "/ideas");
        _label = FirstNonEmpty(Label, site?.GetSetting("poweredby.label")) ?? "MindAttic.Ideas";
        _links = ParseLinks(FirstNonEmpty(Links, site?.GetSetting("footer.links")));
    }

    private static string? FirstNonEmpty(params string?[] values) =>
        values.FirstOrDefault(v => !string.IsNullOrWhiteSpace(v));

    // "Home=/;About=/about" -> [(Home, /), (About, /about)]. Tolerant: skips malformed or unsafe pairs.
    private static IReadOnlyList<(string, string)> ParseLinks(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return Array.Empty<(string, string)>();
        var list = new List<(string, string)>();
        foreach (var pair in raw.Split(';', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            var eq = pair.IndexOf('=');
            if (eq <= 0 || eq == pair.Length - 1) continue;
            var href = pair[(eq + 1)..].Trim();
            if (IsUnsafeUrl(href)) continue;
            list.Add((pair[..eq].Trim(), href));
        }
        return list;
    }

    /// <summary>Settings are author-editable, so a hostile scheme must never reach an href.</summary>
    private static string SafeUrl(string url) => IsUnsafeUrl(url) ? "/" : url;

    private static bool IsUnsafeUrl(string url)
    {
        var trimmed = url.TrimStart();
        return trimmed.StartsWith("javascript:", StringComparison.OrdinalIgnoreCase)
            || trimmed.StartsWith("data:", StringComparison.OrdinalIgnoreCase)
            || trimmed.StartsWith("vbscript:", StringComparison.OrdinalIgnoreCase);
    }
}
