@namespace MindAttic.Ideas.Component.LegionPersonas
@inherits ComponentBase
@attribute [Idea(DisplayName = "Legion Personas", RenderMode = CmsRenderMode.InteractiveServer)]
@attribute [Uses(ContentKind.Plugin, "sacredgeometry", 1)]
@attribute [Uses(ContentKind.Component, "modalpopup", 1)]

@* ============================================================================================
   MindAttic.Ideas.Component.LegionPersonas.V1 — the MindAttic.Legion 1024-persona gallery as a single
   compiled Page shipped as a .idea. Identity by convention: namespace tail "LegionPersonas" => key
   "legionpersonas", class "V1" => version 1. The persona library is the embedded personas.json
   (PersonaData); each card's live avatar is a SacredGeometry shape, animated by the SacredGeometry
   Widget (composed BY STRING ID — never compiled against). The page wears the Cyberspace theme,
   chosen in data/page.json. All CSS is scoped under .legion-personas so it never leaks into the host.
   ============================================================================================ *@

<div class="@_rootClass" style="@_rootStyle">
@* Switch ON the SacredGeometry capability: loads the renderer + the canvas[data-sacred-shape] animator. *@
<CmsInclude Ref="MindAttic.Ideas.Plugin.SacredGeometry.V1" />

<div class="gallery">
    @if (ShowFilters)
    {
    <aside class="filters">
        @if (ShowTitle)
        {
            <h1 class="brand">@(Title ?? "Legion Personas")</h1>
        }
        @if (ShowCounts)
        {
            <p class="muted small">@PersonaData.All.Count personas · @PersonaData.ScoredCount scored</p>
        }

        @if (ShowSearch)
        {
            <input class="f-control" type="search" placeholder="@(SearchPlaceholder ?? "Search name, prompt, quirk…")"
                   @bind="filter.Text" @bind:event="oninput" @bind:after="OnFilterChanged" />
        }

        <label class="f-label">Archetype</label>
        <select class="f-control" @bind="filter.Archetype" @bind:after="OnFilterChanged">
            <option value="">Any archetype</option>
            @foreach (var v in PersonaData.Archetypes) { <option value="@v">@v</option> }
        </select>

        <label class="f-label">Worldview</label>
        <select class="f-control" @bind="filter.Worldview" @bind:after="OnFilterChanged">
            <option value="">Any worldview</option>
            @foreach (var v in PersonaData.Worldviews) { <option value="@v">@v</option> }
        </select>

        <label class="f-label">Background</label>
        <select class="f-control" @bind="filter.Background" @bind:after="OnFilterChanged">
            <option value="">Any background</option>
            @foreach (var v in PersonaData.Backgrounds) { <option value="@v">@v</option> }
        </select>

        <label class="f-label">Pronouns</label>
        <select class="f-control" @bind="filter.Pronouns" @bind:after="OnFilterChanged">
            <option value="">Any pronouns</option>
            @foreach (var v in PersonaData.Pronouns) { <option value="@v">@v</option> }
        </select>

        <label class="f-label">MBTI type</label>
        <select class="f-control" @bind="filter.MbtiType" @bind:after="OnFilterChanged">
            <option value="">Any type</option>
            @foreach (var v in PersonaData.MbtiTypes) { <option value="@v">@v</option> }
        </select>

        <label class="f-label">DISC primary</label>
        <select class="f-control" @bind="filter.DiscPrimary" @bind:after="OnFilterChanged">
            <option value="">Any style</option>
            @foreach (var v in PersonaData.DiscStyles) { <option value="@v">DISC-@v</option> }
        </select>

        <label class="f-label">Enneagram</label>
        <select class="f-control" @bind="filter.EnneagramType" @bind:after="OnFilterChanged">
            <option value="">Any</option>
            @foreach (var t in PersonaData.EnneagramTypes) { <option value="@t">Type @t</option> }
        </select>

        <label class="f-label">Age @filter.MinAge–@filter.MaxAge</label>
        <div class="f-row">
            <input class="f-control" type="number" min="0" max="120" @bind="filter.MinAge" @bind:after="OnFilterChanged" />
            <input class="f-control" type="number" min="0" max="120" @bind="filter.MaxAge" @bind:after="OnFilterChanged" />
        </div>

        <button class="f-clear" type="button" @onclick="Clear">@(ClearLabel ?? "Clear filters")</button>
    </aside>
    }

    <section class="results">
        <div class="results-head">
            <span class="muted">@filtered.Count match@(filtered.Count == 1 ? "" : "es")</span>
            <span class="results-tools">
                @if (ShowPageSize)
                {
                    <label class="page-size">
                        Per page
                        <select @bind="pageSize" @bind:after="OnPageSizeChanged">
                            @foreach (var size in _pageSizes) { <option value="@size">@size</option> }
                        </select>
                    </label>
                }
                @if (PageCount > 1)
                {
                    <span class="pager">
                        <button type="button" @onclick="Prev" disabled="@(page == 0)">‹</button>
                        page @(page + 1) / @PageCount
                        <button type="button" @onclick="Next" disabled="@(page >= PageCount - 1)">›</button>
                    </span>
                }
            </span>
        </div>

        <div class="card-grid">
            @foreach (var p in PageItems)
            {
                <PersonaCard Persona="p" OnClick="() => Select(p)" ShowTags="ShowTags" ArtBackground="@_artBg" />
            }
        </div>
    </section>

    <CmsInclude Ref="MindAttic.Ideas.Component.ModalPopup.V1"
                IsOpen="@(selected is not null)"
                Config='{"showClose":true}'
                OnClose="@EventCallback.Factory.Create(this, (Action)Close)">
        @if (selected is not null)
        {
            <PersonaDetail Persona="selected" ShowProfile="ShowProfile" ArtBackground="@_artBg" />
        }
    </CmsInclude>
</div>
</div>

@code {
    private static readonly int[] PageSizes = { 250, 500, 1000 };

    // ── Content ─────────────────────────────────────────────────────────────────────────────────
    [Parameter, Setting("Title", Group = "Content", Order = 1, Copyable = false)] public string? Title { get; set; } = "Legion Personas";
    [Parameter, Setting("Search placeholder", Group = "Content", Order = 2, Copyable = false)] public string? SearchPlaceholder { get; set; } = "Search name, prompt, quirk…";
    [Parameter, Setting("Clear button label", Group = "Content", Order = 3, Copyable = false)] public string? ClearLabel { get; set; } = "Clear filters";

    // ── Behavior ────────────────────────────────────────────────────────────────────────────────
    [Parameter, Setting("Filter sidebar", Group = "Behavior", Order = 1)] public bool ShowFilters { get; set; } = true;
    [Parameter, Setting("Title in sidebar", Group = "Behavior", Order = 2)] public bool ShowTitle { get; set; } = true;
    [Parameter, Setting("Library counts", Group = "Behavior", Order = 3)] public bool ShowCounts { get; set; } = true;
    [Parameter, Setting("Search box", Group = "Behavior", Order = 4)] public bool ShowSearch { get; set; } = true;
    [Parameter, Setting("Sticky sidebar", Group = "Behavior", Order = 5)] public bool StickyFilters { get; set; } = true;
    [Parameter, Setting("Per-page picker", Group = "Behavior", Order = 6)] public bool ShowPageSize { get; set; } = true;
    [Parameter, Setting("Page sizes", Group = "Behavior", Order = 7, Description = "Comma-separated, e.g. 250,500,1000")] public string? PageSizeOptions { get; set; } = "250,500,1000";
    [Parameter, Setting("Default page size", Group = "Behavior", Order = 8)] public int DefaultPageSize { get; set; } = 250;
    [Parameter, Setting("Sort by", Group = "Behavior", Order = 9, Description = "library (as shipped), name or age")] public string? SortBy { get; set; } = "library";
    [Parameter, Setting("Sort descending", Group = "Behavior", Order = 10)] public bool SortDescending { get; set; }
    [Parameter, Setting("Card tags", Group = "Behavior", Order = 11, Description = "MBTI / Enneagram / DISC chips")] public bool ShowTags { get; set; } = true;
    [Parameter, Setting("Psychometric profile in detail", Group = "Behavior", Order = 12)] public bool ShowProfile { get; set; } = true;
    [Parameter, Setting("Card hover effect", Group = "Behavior", Order = 13)] public bool HoverEffect { get; set; } = true;

    // ── Initial filters ─────────────────────────────────────────────────────────────────────────
    [Parameter, Setting("Initial search", Group = "Initial filters", Order = 1)] public string? InitialSearch { get; set; }
    [Parameter, Setting("Initial archetype", Group = "Initial filters", Order = 2)] public string? InitialArchetype { get; set; }
    [Parameter, Setting("Initial worldview", Group = "Initial filters", Order = 3)] public string? InitialWorldview { get; set; }
    [Parameter, Setting("Initial MBTI type", Group = "Initial filters", Order = 4)] public string? InitialMbti { get; set; }
    [Parameter, Setting("Initial min age", Group = "Initial filters", Order = 5)] public int InitialMinAge { get; set; } = 0;
    [Parameter, Setting("Initial max age", Group = "Initial filters", Order = 6)] public int InitialMaxAge { get; set; } = 120;

    // ── Layout ──────────────────────────────────────────────────────────────────────────────────
    [Parameter, Setting("Sidebar width", Group = "Layout", Order = 1, Description = "Default 280px")] public string? SidebarWidth { get; set; }
    [Parameter, Setting("Card min width", Group = "Layout", Order = 2, Description = "Default 160px")] public string? CardMinWidth { get; set; }
    [Parameter, Setting("Card gap", Group = "Layout", Order = 3, Description = "Default 1rem")] public string? CardGap { get; set; }
    [Parameter, Setting("Results padding", Group = "Layout", Order = 4, Description = "Default 1.25rem 1.5rem")] public string? ResultsPadding { get; set; }
    [Parameter, Setting("Minimum height", Group = "Layout", Order = 5, Description = "Default 100vh")] public string? MinHeight { get; set; }

    // ── Colors / appearance ─────────────────────────────────────────────────────────────────────
    [Parameter, Setting("Panel", Group = "Colors", Order = 1, Description = "Default #121723")] public string? PanelColor { get; set; }
    [Parameter, Setting("Panel 2", Group = "Colors", Order = 2, Description = "Default #1a2130")] public string? Panel2Color { get; set; }
    [Parameter, Setting("Line", Group = "Colors", Order = 3, Description = "Default #232c3d")] public string? LineColor { get; set; }
    [Parameter, Setting("Text", Group = "Colors", Order = 4, Description = "Default #dce1e6")] public string? TextColor { get; set; }
    [Parameter, Setting("Muted text", Group = "Colors", Order = 5, Description = "Default #8b97a8")] public string? MutedColor { get; set; }
    [Parameter, Setting("Accent", Group = "Colors", Order = 6, Description = "Default #3c82ff")] public string? AccentColor { get; set; }
    [Parameter, Setting("Avatar background", Group = "Colors", Order = 7, Description = "Default #0a1014")] public string? ArtBackground { get; set; }
    [Parameter, Setting("Card corner radius", Group = "Appearance", Order = 1, Description = "Default 12px")] public string? CardRadius { get; set; }

    // ── Advanced ────────────────────────────────────────────────────────────────────────────────
    [Parameter, Setting("Extra CSS classes", Group = "Advanced")] public string? CssClass { get; set; }
    [Parameter, Setting("Extra inline style", Group = "Advanced")] public string? CssStyle { get; set; }

    private readonly PersonaFilter filter = new();
    private List<Persona> filtered = new();
    private int[] _pageSizes = PageSizes;
    private int pageSize = PageSizes[0];
    private int page;
    private Persona? selected;

    private string _artBg => string.IsNullOrWhiteSpace(ArtBackground) ? "#0a1014" : ArtBackground!;

    protected override void OnInitialized()
    {
        var sizes = (PageSizeOptions ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(v => int.TryParse(v, out var n) ? n : 0).Where(n => n > 0).Distinct().ToList();
        if (sizes.Count == 0) sizes = PageSizes.ToList();
        if (DefaultPageSize > 0 && !sizes.Contains(DefaultPageSize)) sizes.Add(DefaultPageSize);
        sizes.Sort();
        _pageSizes = sizes.ToArray();
        pageSize = DefaultPageSize > 0 ? DefaultPageSize : _pageSizes[0];

        filter.Text = InitialSearch ?? "";
        filter.Archetype = InitialArchetype ?? "";
        filter.Worldview = InitialWorldview ?? "";
        filter.MbtiType = InitialMbti ?? "";
        filter.MinAge = InitialMinAge;
        filter.MaxAge = InitialMaxAge;
        Recompute();
    }

    private void Recompute()
    {
        var q = PersonaFiltering.Apply(PersonaData.All, filter);
        q = (SortBy ?? "").Trim().ToLowerInvariant() switch
        {
            "name" => SortDescending ? q.OrderByDescending(p => p.Name, StringComparer.OrdinalIgnoreCase) : q.OrderBy(p => p.Name, StringComparer.OrdinalIgnoreCase),
            "age" => SortDescending ? q.OrderByDescending(p => p.Age ?? -1) : q.OrderBy(p => p.Age ?? int.MaxValue),
            _ => SortDescending ? q.Reverse() : q,
        };
        filtered = q.ToList();
        if (page >= PageCount) page = 0;
    }

    private string _rootClass => string.Join(" ", new[]
    {
        "legion-personas",
        HoverEffect ? null : "legion-personas--no-anim",
        StickyFilters ? null : "legion-personas--static-filters",
        ShowFilters ? null : "legion-personas--no-filters",
        CssClass,
    }.Where(c => !string.IsNullOrWhiteSpace(c)));

    private static string? Decl(string name, string? value) => string.IsNullOrWhiteSpace(value) ? null : $"{name}:{value}";

    private string? _rootStyle
    {
        get
        {
            var s = string.Join(";", new[]
            {
                Decl("--panel", PanelColor), Decl("--panel-2", Panel2Color), Decl("--line", LineColor),
                Decl("--text", TextColor), Decl("--muted", MutedColor), Decl("--accent", AccentColor),
                Decl("--lp-art-bg", ArtBackground), Decl("--lp-sidebar-width", SidebarWidth),
                Decl("--lp-card-min", CardMinWidth), Decl("--lp-card-gap", CardGap),
                Decl("--lp-results-padding", ResultsPadding), Decl("--lp-min-height", MinHeight),
                Decl("--lp-card-radius", CardRadius),
                string.IsNullOrWhiteSpace(CssStyle) ? null : CssStyle,
            }.Where(p => p is not null));
            return s.Length > 0 ? s : null;
        }
    }

    private void OnFilterChanged() { page = 0; Recompute(); }

    private void OnPageSizeChanged() { page = 0; Recompute(); }

    private void Clear()
    {
        filter.Text = filter.Archetype = filter.Worldview = filter.Background =
            filter.Pronouns = filter.MbtiType = filter.DiscPrimary = "";
        filter.EnneagramType = null;
        filter.MinAge = 0;
        filter.MaxAge = 120;
        OnFilterChanged();
    }

    private int PageCount => Math.Max(1, (int)Math.Ceiling(filtered.Count / (double)pageSize));
    private IEnumerable<Persona> PageItems => filtered.Skip(page * pageSize).Take(pageSize);

    private void Prev() { if (page > 0) page--; }
    private void Next() { if (page < PageCount - 1) page++; }

    private void Select(Persona p) => selected = p;
    private void Close() => selected = null;
}

<style>
    /* All selectors scoped under .legion-personas so the page never leaks styles into the host/theme. */
    .legion-personas {
        --bg: #0b0e14;
        --panel: #121723;
        --panel-2: #1a2130;
        --line: #232c3d;
        --text: #dce1e6;
        --muted: #8b97a8;
        --accent: #3c82ff;
        color: var(--text);
    }
    .legion-personas * { box-sizing: border-box; }
    .legion-personas .muted { color: var(--muted); }
    .legion-personas .small { font-size: 0.82rem; }

    /* ── layout ───────────────────────────────────────────── */
    .legion-personas .gallery { display: grid; grid-template-columns: var(--lp-sidebar-width, 280px) 1fr; min-height: var(--lp-min-height, 100vh); }
    .legion-personas--no-filters .gallery { grid-template-columns: 1fr; }

    .legion-personas .filters {
        background: var(--panel);
        border-right: 1px solid var(--line);
        padding: 1.25rem 1rem;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        position: sticky;
        top: 0;
        align-self: start;
        height: 100vh;
        overflow-y: auto;
    }
    .legion-personas--static-filters .filters { position: static; height: auto; }
    .legion-personas .brand { font-size: 1.4rem; font-weight: 800; margin: 0 0 0.1rem; letter-spacing: -0.01em; color: var(--text); }
    .legion-personas .f-label { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); margin-top: 0.4rem; }
    .legion-personas .f-control {
        width: 100%;
        background: var(--panel-2);
        color: var(--text);
        border: 1px solid var(--line);
        border-radius: 7px;
        padding: 0.45rem 0.55rem;
        font: inherit;
    }
    .legion-personas .f-row { display: flex; gap: 0.4rem; }
    .legion-personas .f-clear {
        margin-top: 0.8rem;
        background: transparent; color: var(--muted);
        border: 1px solid var(--line); border-radius: 7px;
        padding: 0.45rem; cursor: pointer;
    }
    .legion-personas .f-clear:hover { color: var(--text); border-color: var(--accent); }

    /* ── results ──────────────────────────────────────────── */
    .legion-personas .results { padding: var(--lp-results-padding, 1.25rem 1.5rem); }
    .legion-personas .results-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem; }
    .legion-personas .pager button {
        background: var(--panel-2); color: var(--text); border: 1px solid var(--line);
        border-radius: 6px; padding: 0.2rem 0.6rem; cursor: pointer; margin: 0 0.2rem;
    }
    .legion-personas .pager button:disabled { opacity: 0.4; cursor: default; }

    .legion-personas .results-tools { display: flex; align-items: center; gap: 1rem; }
    .legion-personas .page-size {
        display: inline-flex; align-items: center; gap: 0.4rem;
        color: var(--muted); font-size: 0.85rem;
    }
    .legion-personas .page-size select {
        background: var(--panel-2); color: var(--text); border: 1px solid var(--line);
        border-radius: 6px; padding: 0.2rem 0.4rem; cursor: pointer;
    }

    .legion-personas .card-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(var(--lp-card-min, 160px), 1fr));
        gap: var(--lp-card-gap, 1rem);
    }

    /* ── persona card ─────────────────────────────────────── */
    .legion-personas .persona-card {
        background: var(--panel); border: 1px solid var(--line); border-radius: var(--lp-card-radius, 12px);
        overflow: hidden; cursor: pointer; text-align: left; padding: 0; color: inherit;
        transition: transform 0.08s ease, border-color 0.08s ease;
    }
    .legion-personas .persona-card:hover { transform: translateY(-2px); border-color: var(--accent); }
    .legion-personas--no-anim .persona-card { transition: none; }
    .legion-personas--no-anim .persona-card:hover { transform: none; }
    .legion-personas .persona-art { width: 100%; aspect-ratio: 1 / 1.41; background: var(--lp-art-bg, #0a1014); position: relative; }
    .legion-personas .persona-art-canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
    .legion-personas .persona-card-body { padding: 0.6rem 0.7rem 0.8rem; }
    .legion-personas .persona-card-name { font-weight: 600; }
    .legion-personas .persona-card-sub { color: var(--muted); font-size: 0.8rem; margin: 0.1rem 0 0.4rem; line-height: 1.2; }
    .legion-personas .persona-card-tags { display: flex; flex-wrap: wrap; gap: 0.3rem; }
    .legion-personas .tag { background: var(--panel-2); border: 1px solid var(--line); border-radius: 999px; padding: 0.05rem 0.5rem; font-size: 0.72rem; color: var(--muted); }
    .legion-personas .tag-accent { color: var(--accent); border-color: var(--accent); }

    /* ── detail overlay: .ma-modal + .ma-modal-dialog styles come from the ModalPopup widget ── */
    /* Override the ModalPopup CSS variables to match the Cyberspace/legion palette inside this widget. */
    .legion-personas .ma-modal-dialog {
        --ma-modal-bg: var(--panel);
        --ma-modal-line: var(--line);
        --ma-modal-text: var(--text);
        --ma-modal-muted: var(--muted);
    }
    .legion-personas .persona-detail-head { display: flex; gap: 1rem; align-items: center; }
    .legion-personas .persona-art-lg { width: 88px; aspect-ratio: 1 / 1.41; border-radius: 12px; flex: 0 0 auto; }
    .legion-personas .persona-detail-title h2 { margin: 0; }
    /* .close-btn styles removed: now using .ma-modal-close from ModalPopup widget */
    .legion-personas .persona-bio { white-space: pre-wrap; line-height: 1.5; color: var(--text); margin: 1rem 0; }
    .legion-personas .section { margin: 1.2rem 0 0.4rem; font-size: 1rem; }
    .legion-personas .trait-grid { display: grid; grid-template-columns: 120px 1fr; gap: 0.25rem 0.8rem; margin: 0; }
    .legion-personas .trait { display: contents; }
    .legion-personas .trait dt { color: var(--muted); }
    .legion-personas .trait dd { margin: 0; }
    .legion-personas .scored-line { margin-top: 1rem; }

    @@media (max-width: 720px) {
        .legion-personas .gallery { grid-template-columns: 1fr; }
        .legion-personas .filters { position: static; height: auto; }
    }
</style>
