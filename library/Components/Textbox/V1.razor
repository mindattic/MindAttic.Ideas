@namespace MindAttic.Ideas.Component.Textbox
@inherits ComponentBase
@using Microsoft.JSInterop
@using MindAttic.Ideas.Library.Shared
@inject IJSRuntime JS

@* MindAttic.Ideas.Component.Textbox.V1 — an Angular-Material-style OUTLINED text field: the label sits in
   the box at rest and floats up to OVERLAP the top border on focus/fill. Demonstrates a Component that is
   configured like a React/Angular component — typed [Parameter] props (Label / Type / Value) PLUS
   pass-through attributes (ComponentBase.Attributes spread onto the <input>, e.g. required, maxlength,
   data-*). Styled by its own bundled css, served from this .idea's wwwroot at /_ideas/Component/textbox/1/.
   Also the v1 Shadow DOM proof-of-concept (docs/AUTHORING.md "Shadow DOM isolation"): its root has
   structurally stable, unconditional children -- no top-level @if/element-type-swap -- which is exactly
   the authoring contract shadow isolation requires. The <link> stays in light DOM unconditionally (so a
   failed/skipped attach still renders fully styled, MAI-LAW-7) and its URL is ALSO handed to the shadow
   root for adoption, so .ma-field-input/.ma-field-label still resolve once the root is isolated. *@
<link rel="stylesheet" href="/_ideas/Component/textbox/1/textbox.css" />
<div class="ma-field" style="@_rootStyle" @ref="_root">
    <input class="ma-field-input" type="@Type" value="@Value"
           placeholder=" " @attributes="Attributes" id="@InputId" />
    <label for="@InputId" class="ma-field-label">@Label</label>
</div>

@code {
    /// <summary>The floating label text.</summary>
    [Parameter, Setting("Label", Group = "Content", Order = 1, Copyable = false)] public string? Label { get; set; }

    /// <summary>Input type (text, email, password, …). Defaults to text.</summary>
    [Parameter, Setting("Input type", Group = "Behavior", Order = 1, Description = "text | email | password | number | tel | url | search | …")] public string Type { get; set; } = "text";

    /// <summary>Initial value.</summary>
    [Parameter, Setting("Initial value", Group = "Content", Order = 2, Copyable = false)] public string? Value { get; set; }

    // Every visual setting is a CSS custom property on the root: custom properties inherit into the
    // shadow root, so they work identically with or without Shadow DOM isolation.
    [Parameter, Setting("Transitions", Group = "Behavior", Order = 2, Description = "Label float and border transitions")] public bool Animate { get; set; } = true;
    [Parameter, Setting("Full width", Group = "Layout", Order = 1, Description = "Stretch to the container's width")] public bool FullWidth { get; set; }
    [Parameter, Setting("Minimum width", Group = "Layout", Order = 2, Description = "Default 240px")] public string? MinWidth { get; set; }
    [Parameter, Setting("Margin", Group = "Layout", Order = 3, Description = "Default 14px 0")] public string? Margin { get; set; }
    [Parameter, Setting("Font size", Group = "Layout", Order = 4, Description = "Default 1rem")] public string? FontSize { get; set; }
    [Parameter, Setting("Font family", Group = "Layout", Order = 5)] public string? FontFamily { get; set; }
    [Parameter, Setting("Corner radius", Group = "Layout", Order = 6, Description = "Default 6px")] public string? Radius { get; set; }
    [Parameter, Setting("Text color", Group = "Colors", Order = 1, Description = "Default #1f1f1f")] public string? TextColor { get; set; }
    [Parameter, Setting("Border / label color", Group = "Colors", Order = 2, Description = "Default #79747e")] public string? BorderColor { get; set; }
    [Parameter, Setting("Accent (focus) color", Group = "Colors", Order = 3, Description = "Default #6750a4")] public string? AccentColor { get; set; }
    [Parameter, Setting("Backdrop color", Group = "Colors", Order = 4, Description = "Behind the floated label; match the page background (default #ffffff)")] public string? Background { get; set; }
    [Parameter, Setting("Input background", Group = "Colors", Order = 5, Description = "Default transparent")] public string? InputBackground { get; set; }

    private static string? Var(string name, string? value) =>
        string.IsNullOrWhiteSpace(value) ? null : $"{name}:{value}";

    // Null when nothing is set, so the default render carries no style attribute at all.
    private string? _rootStyle
    {
        get
        {
            var s = string.Join(";", new[]
            {
                Animate ? null : "--ma-field-transition:none",
                FullWidth ? "display:flex;--ma-field-input-flex:1 1 auto" : null,
                Var("--ma-field-min-width", MinWidth),
                Var("--ma-field-margin", Margin),
                Var("--ma-field-font-size", FontSize),
                Var("--ma-field-font", FontFamily),
                Var("--ma-field-radius", Radius),
                Var("--ma-field-fg", TextColor),
                Var("--ma-field-border", BorderColor),
                Var("--ma-field-accent", AccentColor),
                Var("--ma-field-bg", Background),
                Var("--ma-field-input-bg", InputBackground),
            }.Where(v => v is not null));
            return s.Length == 0 ? null : s;
        }
    }

    protected override bool UseShadowDom => true;

    private ElementReference _root;
    private static readonly string[] CssUrls = ["/_ideas/Component/textbox/1/textbox.css"];

    // Stable per-instance id so the <label for> binds to this input (unique across multiple placements).
    // A caller-supplied id (via the attribute bag) wins, and the label must follow it — so the explicit
    // id sits after the @attributes spread and both elements read the same resolved value.
    private readonly string _id = "ma-tb-" + Guid.NewGuid().ToString("N").Substring(0, 8);

    private string InputId =>
        Attributes is not null && Attributes.TryGetValue("id", out var custom) && custom is not null
            ? custom.ToString()!
            : _id;

    // Only attempts the shadow attach once a real circuit is connected -- static prerender has no JS
    // runtime, so the component simply renders its normal, fully-styled light-DOM markup (MAI-LAW-7).
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && UseShadowDom && RendererInfo.IsInteractive)
            await ShadowDomAttach.AttachAsync(JS, _root, CssUrls);
    }
}
