@namespace MindAttic.Ideas.Component.IdeasFrontpage
@inherits ComponentBase

<link rel="stylesheet" href="/_ideas/Component/ideasfrontpage/1/ifp.css" />

<!-- ── Slide-in navigation drawer ─────────────────────────────────────────── -->
<div class="ifp-drawer-overlay" id="ifp-overlay" role="presentation"></div>
<nav class="ifp-drawer" id="ifp-drawer" aria-label="Page sections">
  <button class="ifp-drawer-close" id="ifp-drawer-close" aria-label="Close navigation">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
      <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
    </svg>
  </button>
  <div class="ifp-drawer-brand">Ideas</div>
  <ul class="ifp-drawer-links">
    <li><a href="#ifp-why">Why Ideas</a></li>
    <li><a href="#ifp-primitives">Primitives</a></li>
    <li><a href="#ifp-grammar">Tag Grammar</a></li>
    <li><a href="#ifp-anatomy">.idea Anatomy</a></li>
    <li><a href="#ifp-features">Features</a></li>
    <li><a href="#ifp-tech">Tech Stack</a></li>
    <li><a href="#ifp-start">Get Started</a></li>
  </ul>
</nav>

<div class="ifp" id="ifp-root">

  <!-- ── Sticky header ─────────────────────────────────────────────────────── -->
  <header class="ifp-header" role="banner">
    <div class="ifp-header-col ifp-header-left">
      <button class="ifp-hamburger" id="ifp-hamburger" aria-label="Open navigation" aria-expanded="false" aria-controls="ifp-drawer">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </button>
    </div>
    <div class="ifp-header-col ifp-header-center">
      <span class="ifp-logo" aria-label="MindAttic Ideas">Ideas</span>
    </div>
    <div class="ifp-header-col ifp-header-right">
      <button class="ifp-theme-btn" id="ifp-theme-btn" aria-label="Toggle light/dark theme">
        <svg class="ifp-icon ifp-icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="5"/>
          <line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
          <line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
        </svg>
        <svg class="ifp-icon ifp-icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>
      <div class="ifp-avatar" aria-label="Ryan DeBraal" title="Ryan DeBraal">RD</div>
    </div>
  </header>

  <!-- ── Hero ──────────────────────────────────────────────────────────────── -->
  <section class="ifp-hero" aria-label="Introduction">
    <div class="ifp-hero-bg" aria-hidden="true">
      <svg class="ifp-hero-svg" viewBox="0 0 1200 600" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="ifp-grid" x="0" y="0" width="60" height="60" patternUnits="userSpaceOnUse">
            <circle cx="30" cy="30" r="1" fill="currentColor" opacity="0.25"/>
          </pattern>
        </defs>
        <rect width="1200" height="600" fill="url(#ifp-grid)"/>
        <circle cx="120" cy="180" r="90" fill="currentColor" opacity="0.04"/>
        <circle cx="1100" cy="420" r="120" fill="currentColor" opacity="0.04"/>
        <circle cx="600" cy="80" r="50" fill="currentColor" opacity="0.05"/>
        <circle cx="900" cy="150" r="30" fill="currentColor" opacity="0.06"/>
      </svg>
    </div>
    <div class="ifp-hero-inner">
      <p class="ifp-eyebrow ifp-reveal">MindAttic.Ideas &mdash; v1</p>
      <h1 class="ifp-title">
        <span class="ifp-title-line ifp-reveal ifp-reveal-d1">The CMS that</span>
        <span class="ifp-title-line ifp-title-accent ifp-reveal ifp-reveal-d2">gets out of the way.</span>
      </h1>
      <p class="ifp-subtitle ifp-reveal ifp-reveal-d3">
        Upload a <code class="ifp-code">.idea</code> zip and it goes live instantly &mdash;
        no redeploy, no pipeline, no ceremony.
        Pages are free-form HTML. Widgets are self-contained packages.
      </p>
      <div class="ifp-badges ifp-reveal ifp-reveal-d4">
        <span class="ifp-badge">Hot-load</span>
        <span class="ifp-badge">Zero-redeploy</span>
        <span class="ifp-badge">Free-form pages</span>
        <span class="ifp-badge">Blazor Server</span>
        <span class="ifp-badge">.NET 10</span>
        <span class="ifp-badge">SQL Server</span>
      </div>
      <a class="ifp-cta-btn ifp-reveal ifp-reveal-d5" href="#ifp-why">
        See what makes it different
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <line x1="12" y1="5" x2="12" y2="19"/><polyline points="19 12 12 19 5 12"/>
        </svg>
      </a>
    </div>
  </section>

  <!-- ── Stats bar ─────────────────────────────────────────────────────────── -->
  <div class="ifp-stats ifp-reveal" aria-label="Quick statistics">
    <div class="ifp-stat">
      <strong>3</strong><span>Primitives</span>
    </div>
    <div class="ifp-stat-sep" aria-hidden="true"></div>
    <div class="ifp-stat">
      <strong>0</strong><span>Redeploys needed</span>
    </div>
    <div class="ifp-stat-sep" aria-hidden="true"></div>
    <div class="ifp-stat">
      <strong>1</strong><span>File per widget</span>
    </div>
    <div class="ifp-stat-sep" aria-hidden="true"></div>
    <div class="ifp-stat">
      <strong>100%</strong><span>Blazor Server</span>
    </div>
  </div>

  <!-- ── Why Ideas ─────────────────────────────────────────────────────────── -->
  <section class="ifp-section" id="ifp-why" aria-labelledby="ifp-why-h">
    <h2 class="ifp-section-title ifp-reveal" id="ifp-why-h">Why MindAttic.Ideas?</h2>
    <p class="ifp-section-lead ifp-reveal ifp-reveal-d1">
      Most CMSes add layers between you and your content. Ideas removes them.
      The result is a system you can understand completely &mdash; and extend in minutes.
    </p>
    <div class="ifp-why-grid">
      <article class="ifp-why-card ifp-reveal ifp-reveal-d1">
        <div class="ifp-why-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
          </svg>
        </div>
        <h3>Live without a redeploy</h3>
        <p>Upload a <code class="ifp-code">.idea</code> through Admin &rarr; Upload.
           Installed instantly, catalog updated, available to every page. No IIS restart. No pipeline.</p>
      </article>
      <article class="ifp-why-card ifp-reveal ifp-reveal-d2">
        <div class="ifp-why-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
            <polyline points="14 2 14 8 20 8"/>
            <line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/>
            <polyline points="10 9 9 9 8 9"/>
          </svg>
        </div>
        <h3>Pages are just HTML</h3>
        <p>Slug, title, body. Write markup; drop <code class="ifp-code">&lt;Component.Tabs /&gt;</code>
           wherever a widget belongs. No zones. No drag-and-drop. No layout XML.</p>
      </article>
      <article class="ifp-why-card ifp-reveal ifp-reveal-d3">
        <div class="ifp-why-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
        </div>
        <h3>Integrity you can rely on</h3>
        <p>Delete-guards block removing a widget that a live page still references.
           Disabled widgets degrade gracefully; the admin inbox gets an alert; pages keep serving.</p>
      </article>
      <article class="ifp-why-card ifp-reveal ifp-reveal-d4">
        <div class="ifp-why-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/>
            <line x1="15" y1="9" x2="15.01" y2="9"/>
          </svg>
        </div>
        <h3>Themes that can&apos;t break you</h3>
        <p>Themes control typography and color, never the admin UI or routes.
           Swap themes in Admin &rarr; Settings. A broken theme cannot lock you out.</p>
      </article>
      <article class="ifp-why-card ifp-reveal ifp-reveal-d5">
        <div class="ifp-why-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
          </svg>
        </div>
        <h3>Each widget is one file</h3>
        <p>A <code class="ifp-code">.idea</code> archive is compiled Blazor component + scoped CSS + JS
           in one zip. No NuGet. No npm. No build step at runtime.</p>
      </article>
      <article class="ifp-why-card ifp-reveal ifp-reveal-d6">
        <div class="ifp-why-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
          </svg>
        </div>
        <h3>Compose, don&apos;t configure</h3>
        <p>Instead of configuring modules, permissions, and panes, you compose pages from primitives.
           Each primitive does one thing. Three primitives cover everything.</p>
      </article>
    </div>
  </section>

  <!-- ── Three Primitives ──────────────────────────────────────────────────── -->
  <section class="ifp-section ifp-section-alt" id="ifp-primitives" aria-labelledby="ifp-prim-h">
    <h2 class="ifp-section-title ifp-reveal" id="ifp-prim-h">Three primitives. That&apos;s the whole model.</h2>
    <p class="ifp-section-lead ifp-reveal ifp-reveal-d1">A CMS has one job: connect content to presentation. That takes exactly three things.</p>
    <div class="ifp-primitives">
      <article class="ifp-primitive ifp-reveal ifp-reveal-d1">
        <header class="ifp-primitive-header ifp-prim-page">
          <svg class="ifp-prim-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/>
          </svg>
          <span class="ifp-prim-kind">Page</span>
        </header>
        <div class="ifp-prim-body">
          <h3>Free-form HTML in a database row</h3>
          <p>Slug, title, body, theme, trust level. Embed widget tags anywhere in the body.
             Supports compiled Blazor pages for full server-side logic.</p>
          <ul class="ifp-prim-facts">
            <li>Data pages &mdash; free-form HTML with embedded tags</li>
            <li>Code pages &mdash; compiled Blazor components</li>
            <li>Per-page theme override</li>
            <li>SEO title, publish flag, soft-delete</li>
          </ul>
        </div>
      </article>
      <article class="ifp-primitive ifp-reveal ifp-reveal-d2">
        <header class="ifp-primitive-header ifp-prim-plugin">
          <svg class="ifp-prim-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/>
            <rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/>
          </svg>
          <span class="ifp-prim-kind">Plugin</span>
        </header>
        <div class="ifp-prim-body">
          <h3>A site-wide capability, loaded once</h3>
          <p>Plugins activate site-wide features &mdash; tooltip engine, navigation, footer.
             They load CSS and JS once through the page <code class="ifp-code">&lt;head&gt;</code>.</p>
          <ul class="ifp-prim-facts">
            <li>Selected per-page in Admin &rarr; Pages</li>
            <li>Assets injected once into <code class="ifp-code">&lt;head&gt;</code></li>
            <li>Versioned &mdash; pin or float to latest</li>
            <li>Graceful degradation if missing or disabled</li>
          </ul>
        </div>
      </article>
      <article class="ifp-primitive ifp-reveal ifp-reveal-d3">
        <header class="ifp-primitive-header ifp-prim-comp">
          <svg class="ifp-prim-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polygon points="12 2 22 8.5 22 15.5 12 22 2 15.5 2 8.5 12 2"/>
          </svg>
          <span class="ifp-prim-kind">Component</span>
        </header>
        <div class="ifp-prim-body">
          <h3>An inline element, placed by tag</h3>
          <p>Atomic elements dropped into the page body by tag. A tabs board, a gallery, a hero section &mdash;
             each is a self-contained <code class="ifp-code">.idea</code> package.</p>
          <ul class="ifp-prim-facts">
            <li>Placed via <code class="ifp-code">&lt;Component.Key /&gt;</code></li>
            <li>Attributes flow through to Blazor <code class="ifp-code">[Parameter]</code>s</li>
            <li>Typed coercion: <code class="ifp-code">count="5"</code> &rarr; <code class="ifp-code">int</code></li>
            <li>Inner HTML passed as <code class="ifp-code">ChildContent</code></li>
          </ul>
        </div>
      </article>
    </div>
  </section>

  <!-- ── Tag Grammar ───────────────────────────────────────────────────────── -->
  <section class="ifp-section" id="ifp-grammar" aria-labelledby="ifp-gram-h">
    <h2 class="ifp-section-title ifp-reveal" id="ifp-gram-h">The tag grammar</h2>
    <p class="ifp-section-lead ifp-reveal ifp-reveal-d1">
      Embed a widget by writing a PascalCase HTML tag.
      The kind prefix routes to the right catalog. Attributes pass straight through.
    </p>
    <div class="ifp-grammar-grid ifp-reveal ifp-reveal-d2">
      <div class="ifp-grammar-code">
        <p class="ifp-caption">Page body &mdash; Monaco editor:</p>
        <pre class="ifp-pre" role="region" aria-label="Example page body"><code><span class="ifp-ck-html">&lt;h2&gt;</span>Our Projects<span class="ifp-ck-html">&lt;/h2&gt;</span>
<span class="ifp-ck-comp">&lt;Component.TabBoard /&gt;</span>

<span class="ifp-ck-html">&lt;h2&gt;</span>Selected Work<span class="ifp-ck-html">&lt;/h2&gt;</span>
<span class="ifp-ck-comp">&lt;Component.Gallery /&gt;</span>

<span class="ifp-ck-comment">&lt;!-- Pin to exact version: --&gt;</span>
<span class="ifp-ck-plugin">&lt;Plugin.Tooltip data-version="2" /&gt;</span>

<span class="ifp-ck-comment">&lt;!-- Pass attributes: --&gt;</span>
<span class="ifp-ck-comp">&lt;Component.Hero title="Hello world" /&gt;</span>

<span class="ifp-ck-comment">&lt;!-- Inner content: --&gt;</span>
<span class="ifp-ck-comp">&lt;Component.Card&gt;</span>
  <span class="ifp-ck-html">&lt;p&gt;</span>Custom body<span class="ifp-ck-html">&lt;/p&gt;</span>
<span class="ifp-ck-comp">&lt;/Component.Card&gt;</span></code></pre>
      </div>
      <div class="ifp-grammar-rules">
        <p class="ifp-caption">Resolution rules:</p>
        <ul class="ifp-rule-list">
          <li>
            <svg class="ifp-rule-icon" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><circle cx="8" cy="8" r="8"/></svg>
            <span><strong>Kind prefix</strong> &mdash; <code class="ifp-code">Component.X</code> or <code class="ifp-code">Plugin.X</code> routes to the right catalog</span>
          </li>
          <li>
            <svg class="ifp-rule-icon" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><circle cx="8" cy="8" r="8"/></svg>
            <span><strong>Floating</strong> &mdash; no <code class="ifp-code">data-version</code> &rarr; latest installed</span>
          </li>
          <li>
            <svg class="ifp-rule-icon" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><circle cx="8" cy="8" r="8"/></svg>
            <span><strong>Pinned</strong> &mdash; <code class="ifp-code">data-version="2"</code> &rarr; that exact version, always</span>
          </li>
          <li>
            <svg class="ifp-rule-icon" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><circle cx="8" cy="8" r="8"/></svg>
            <span><strong>Missing</strong> &rarr; clickable placeholder; admin inbox alert raised</span>
          </li>
          <li>
            <svg class="ifp-rule-icon" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><circle cx="8" cy="8" r="8"/></svg>
            <span><strong>Disabled</strong> &rarr; same graceful degradation; page still serves</span>
          </li>
          <li>
            <svg class="ifp-rule-icon" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><circle cx="8" cy="8" r="8"/></svg>
            <span><strong>Monaco IntelliSense</strong> &rarr; autocomplete lists all installed widgets</span>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ── .idea anatomy ─────────────────────────────────────────────────────── -->
  <section class="ifp-section ifp-section-alt" id="ifp-anatomy" aria-labelledby="ifp-anat-h">
    <h2 class="ifp-section-title ifp-reveal" id="ifp-anat-h">Anatomy of a <code class="ifp-code">.idea</code> package</h2>
    <p class="ifp-section-lead ifp-reveal ifp-reveal-d1">
      One file. Drop it in Admin &rarr; Upload or via the CLI. Installed live &mdash; no restart required.
    </p>
    <div class="ifp-anatomy-grid">
      <div class="ifp-anatomy-tree ifp-reveal ifp-reveal-d2">
        <pre class="ifp-pre" role="region" aria-label="Package structure"><code><span class="ifp-ck-dir">MindAttic.Ideas.Component.Tabs.V1.idea</span>  <span class="ifp-ck-comment">(zip)</span>
<span class="ifp-ck-dir">├── idea.json</span>        <span class="ifp-ck-comment">← manifest (packer-generated)</span>
<span class="ifp-ck-dir">├── bin/</span>
<span class="ifp-ck-dir">│   └── Tabs.dll</span>     <span class="ifp-ck-comment">← compiled Blazor component</span>
<span class="ifp-ck-dir">└── wwwroot/</span>
<span class="ifp-ck-dir">    ├── tabs.css</span>     <span class="ifp-ck-comment">← scoped CSS (.ma-tabs-* prefix)</span>
<span class="ifp-ck-dir">    └── tabs.js</span>      <span class="ifp-ck-comment">← scoped JS (IIFE, no globals)</span></code></pre>
      </div>
      <div class="ifp-anatomy-facts">
        <div class="ifp-fact ifp-reveal ifp-reveal-d2">
          <strong>idea.json manifest</strong>
          <span>Generated by the packer from reflection. Lists entry type, assembly name, CSS/JS assets, and declared <code class="ifp-code">uses[]</code> dependencies.</span>
        </div>
        <div class="ifp-fact ifp-reveal ifp-reveal-d3">
          <strong>Whole-number versioning</strong>
          <span>V1, V2, V3 &mdash; never 2.6.0. The CMS tracks each version independently so pages can pin or float independently.</span>
        </div>
        <div class="ifp-fact ifp-reveal ifp-reveal-d4">
          <strong>Versioned asset path</strong>
          <span>Assets land at <code class="ifp-code">/_ideas/Component/tabs/1/tabs.css</code>. Long cache headers. New version = new URL = safe cache bust.</span>
        </div>
        <div class="ifp-fact ifp-reveal ifp-reveal-d5">
          <strong>No globals, no leaks</strong>
          <span>Every CSS selector scoped to a widget-specific prefix. Every JS wrapped in an IIFE. Widgets never pollute each other.</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Feature comparison table ──────────────────────────────────────────── -->
  <section class="ifp-section" id="ifp-features" aria-labelledby="ifp-feat-h">
    <h2 class="ifp-section-title ifp-reveal" id="ifp-feat-h">Feature overview</h2>
    <div class="ifp-table-wrap ifp-reveal ifp-reveal-d1">
      <table class="ifp-table" role="table">
        <thead>
          <tr>
            <th scope="col">Feature</th>
            <th scope="col">Ideas</th>
            <th scope="col">Traditional CMS</th>
          </tr>
        </thead>
        <tbody>
          <tr><td>Deploy a new widget</td><td class="ifp-yes"><span class="ifp-check" aria-hidden="true">✓</span> Upload .idea &mdash; live instantly</td><td class="ifp-no"><span class="ifp-x" aria-hidden="true">✗</span> Redeploy entire application</td></tr>
          <tr><td>Page structure</td><td class="ifp-yes"><span class="ifp-check" aria-hidden="true">✓</span> Free-form HTML + embedded tags</td><td class="ifp-no"><span class="ifp-x" aria-hidden="true">✗</span> Zones, panes, layout XML</td></tr>
          <tr><td>Widget isolation</td><td class="ifp-yes"><span class="ifp-check" aria-hidden="true">✓</span> Scoped CSS prefix + IIFE per widget</td><td class="ifp-no"><span class="ifp-x" aria-hidden="true">✗</span> Shared global CSS/JS namespace</td></tr>
