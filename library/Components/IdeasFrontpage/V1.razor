<script>
(function () {
  'use strict';

  // ── Theme ─────────────────────────────────────────────────────────────────
  var root = document.getElementById('ifp-root');
  var themeBtn = document.getElementById('ifp-theme-btn');
  var THEME_KEY = 'ifp-theme';
  var DARK = 'dark', LIGHT = 'light';

  function applyTheme(t) {
    if (root) root.setAttribute('data-ifp-theme', t);
    if (themeBtn) themeBtn.setAttribute('aria-label', t === DARK ? 'Switch to light mode' : 'Switch to dark mode');
    try { localStorage.setItem(THEME_KEY, t); } catch(e) {}
  }

  var saved;
  try { saved = localStorage.getItem(THEME_KEY); } catch(e) {}
  applyTheme(saved === LIGHT ? LIGHT : DARK);

  if (themeBtn) {
    themeBtn.addEventListener('click', function () {
      var current = root ? root.getAttribute('data-ifp-theme') : DARK;
      applyTheme(current === DARK ? LIGHT : DARK);
    });
  }

  // ── Hamburger drawer ─────────────────────────────────────────────────────
  var drawer = document.getElementById('ifp-drawer');
  var overlay = document.getElementById('ifp-overlay');
  var hamburger = document.getElementById('ifp-hamburger');
  var drawerClose = document.getElementById('ifp-drawer-close');

  function openDrawer() {
    if (drawer) drawer.classList.add('ifp-drawer-open');
    if (overlay) overlay.classList.add('ifp-overlay-visible');
    if (hamburger) hamburger.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  }

  function closeDrawer() {
    if (drawer) drawer.classList.remove('ifp-drawer-open');
    if (overlay) overlay.classList.remove('ifp-overlay-visible');
    if (hamburger) hamburger.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }

  if (hamburger) hamburger.addEventListener('click', openDrawer);
  if (drawerClose) drawerClose.addEventListener('click', closeDrawer);
  if (overlay) overlay.addEventListener('click', closeDrawer);

  // Close drawer when a nav link is clicked.
  if (drawer) {
    drawer.querySelectorAll('a').forEach(function(a) {
      a.addEventListener('click', closeDrawer);
    });
  }

  // ── Scroll-reveal (Intersection Observer) ────────────────────────────────
  var revealEls = document.querySelectorAll('.ifp-reveal');
  if ('IntersectionObserver' in window && revealEls.length) {
    var obs = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('ifp-visible');
          obs.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -3rem 0px' });
    revealEls.forEach(function(el) { obs.observe(el); });
  } else {
    // Fallback: show everything immediately.
    revealEls.forEach(function(el) { el.classList.add('ifp-visible'); });
  }

  // ── Current year in footer ────────────────────────────────────────────────
  var yearEl = document.querySelector('.ifp-year');
  if (yearEl) yearEl.textContent = String(new Date().getFullYear());

  // ── Smooth-scroll for header anchor offset ────────────────────────────────
  var headerEl = document.querySelector('.ifp-header');
  document.querySelectorAll('a[href^="#ifp-"]').forEach(function(a) {
    a.addEventListener('click', function(e) {
      var id = a.getAttribute('href').slice(1);
      var target = document.getElementById(id);
      if (!target) return;
      e.preventDefault();
      var headerH = headerEl ? headerEl.offsetHeight : 0;
      var top = target.getBoundingClientRect().top + window.pageYOffset - headerH - 16;
      window.scrollTo({ top: top, behavior: 'smooth' });
    });
  });
})();
</script>
