@namespace MindAttic.Ideas.Component.AppLaunch
@using System.Text.Json
@inherits ComponentBase
@attribute [Idea(DisplayName = "App Launch")]

@* MindAttic.Ideas.Component.AppLaunch.V1 — a landing-page tile that opens a hosted app borderless.

   <Component.AppLaunch url="/_ideas/Component/hyperspace/1/index.htm"
                        title="Hyperspace" blurb="A starfield you can fly."
                        mode="fullscreen" />

   Three modes; see assets/applaunch.js for the browser rule that forces the ladder.
     fullscreen (default)  overlay iframe in THIS window + Fullscreen API. Zero browser chrome.
     window                a real separate window; the opened page goes borderless on its own
                           first gesture (it must be an Ideas page carrying this component).
     inline                embedded, no launch step, with a fullscreen affordance.

   Assets are hoisted into <head> by the host (PageAssetCollector), so no <link>/<script> here. *@

@if (_mode == "inline")
{
    <div class="ma-applaunch-inline @_modClass @CssClass" style="@_outerStyle">
        <iframe class="ma-applaunch-frame" src="@_url" title="@_title"
                allowfullscreen allow="fullscreen; autoplay; gamepad; clipboard-write; xr-spatial-tracking"></iframe>
        @if (_showExpand)
        {
            <button type="button" class="ma-applaunch-expand" data-ma-applaunch-expand
                    aria-label="Show @_title fullscreen">@ExpandText</button>
        }
    </div>
}
else
{
    <div class="ma-applaunch @_modClass @CssClass" style="@_outerStyle">
        @if (ShowPoster && !string.IsNullOrWhiteSpace(_poster))
        {
            <img class="ma-applaunch-poster" src="@_poster" alt="" loading="lazy" decoding="async" />
        }
        @if (!string.IsNullOrWhiteSpace(_title))
        {
            <p class="ma-applaunch-title">@_title</p>
        }
        @if (!string.IsNullOrWhiteSpace(_blurb))
        {
            <p class="ma-applaunch-blurb">@_blurb</p>
        }
        <button type="button" class="ma-applaunch-btn"
                data-ma-applaunch
                data-url="@_url"
                data-title="@_title"
                data-mode="@_mode"
                data-width="@_width"
                data-height="@_height"
                data-target="@Target">@_buttonText</button>
    </div>
}

@code {
    private const string Mount = "/_ideas/Component/applaunch/1";

    public override IReadOnlyList<string> StylesheetUrls { get; } = new[] { Mount + "/applaunch.css" };
    public override IReadOnlyList<string> ScriptUrls { get; } = new[] { Mount + "/applaunch.js" };

    /// <summary>The app to launch: an /_ideas asset path, an Ideas page slug, or an absolute URL.</summary>
    [Parameter, Setting("App URL", Group = "Content", Order = 1, Copyable = false, Description = "/_ideas asset path, page slug, or absolute URL")]
    public string? Url { get; set; }

    /// <summary>App name — the tile heading, the iframe's accessible name, and the dialog label.</summary>
    [Parameter, Setting("Title", Group = "Content", Order = 2, Copyable = false, Description = "Default \"Application\"")]
    public string? Title { get; set; }

    /// <summary>One-line description under the title. Omit to suppress.</summary>
    [Parameter, Setting("Blurb", Group = "Content", Order = 3, Copyable = false, Multiline = true)]
    public string? Blurb { get; set; }

    /// <summary>Launch button label. Defaults to "Launch".</summary>
    [Parameter, Setting("Button text", Group = "Content", Order = 4, Copyable = false, Description = "Default \"Launch\"")]
    public string? ButtonText { get; set; }

    /// <summary>"fullscreen" (default), "window", or "inline".</summary>
    [Parameter, Setting("Launch mode", Group = "Behavior", Order = 1, Description = "fullscreen (default), window, or inline")]
    public string? Mode { get; set; }

    /// <summary>Poster image URL for the tile. Ignored when <see cref="PosterUid"/> is set.</summary>
    [Parameter, Setting("Poster URL", Group = "Content", Order = 5, Copyable = false)]
    public string? PosterUrl { get; set; }

    /// <summary>Managed-media uid for the poster, served from /_media/{uid}.</summary>
    [Parameter, Setting("Poster media uid", Group = "Content", Order = 6, Copyable = false)]
    public string? PosterUid { get; set; }

    /// <summary>Separate-window width in CSS pixels (mode="window"). Default 1280.</summary>
    [Parameter, Setting("Window width (px)", Group = "Behavior", Order = 2, Description = "mode=window; default 1280")]
    public int? Width { get; set; }

    /// <summary>Separate-window height in CSS pixels (mode="window"). Default 800.</summary>
    [Parameter, Setting("Window height (px)", Group = "Behavior", Order = 3, Description = "mode=window; default 800")]
    public int? Height { get; set; }

    /// <summary>Named window target, so re-launching reuses one window instead of stacking them.</summary>
    [Parameter, Setting("Window target name", Group = "Behavior", Order = 4, Description = "Re-launching reuses one named window")]
    public string? Target { get; set; }

    /// <summary>Aspect ratio for inline/poster framing, e.g. "16/9" or "4/3". Default 16/9.</summary>
    [Parameter, Setting("Aspect ratio", Group = "Layout", Order = 4, Description = "Inline frame + poster, e.g. 16/9 (default) or 4/3")]
    public string? Ratio { get; set; }

    /// <summary>Whether inline mode shows its fullscreen button. Default true.</summary>
    [Parameter, Setting("Show fullscreen button (inline)", Group = "Behavior", Order = 5, Description = "Default on")]
    public bool? ShowExpand { get; set; }

    /// <summary>Inline-mode fullscreen button label. Default "⤢".</summary>
    [Parameter, Setting("Fullscreen button label", Group = "Content", Order = 7, Copyable = false)]
    public string ExpandText { get; set; } = "⤢";

    /// <summary>Show the poster image on the tile when one is configured.</summary>
    [Parameter, Setting("Show poster", Group = "Behavior", Order = 6)]
    public bool ShowPoster { get; set; } = true;

    /// <summary>Tile/button transitions (hover, press, fullscreen-button fade).</summary>
    [Parameter, Setting("Animations", Group = "Behavior", Order = 7)]
    public bool Animations { get; set; } = true;

    /// <summary>JSON blob carrying any of the above (camel- or pascal-case). Explicit parameters win.</summary>
    [Parameter, Setting("Config JSON", Group = "Advanced", Copyable = false, Multiline = true, Description = "Any of the above as JSON; explicit settings win")]
    public string? Config { get; set; }

    [Parameter, Setting("Extra CSS classes", Group = "Advanced")] public string? CssClass { get; set; }
    [Parameter, Setting("Extra inline style", Group = "Advanced")] public string? CssStyle { get; set; }
    [Parameter, Setting("Padding", Group = "Layout", Order = 1)] public string? Padding { get; set; }
    [Parameter, Setting("Margin", Group = "Layout", Order = 2)] public string? Margin { get; set; }
    [Parameter, Setting("Alignment", Group = "Layout", Order = 3)] public string? Align { get; set; }

    [Parameter, Setting("Tile max width", Group = "Layout", Order = 5, Description = "Default 22rem")] public string? MaxWidth { get; set; }
    [Parameter, Setting("Corner radius", Group = "Layout", Order = 6, Description = "Tile + inline frame (default 14px)")] public string? Radius { get; set; }
    [Parameter, Setting("Title font size", Group = "Layout", Order = 7, Description = "Default 1.15rem")] public string? TitleSize { get; set; }

    [Parameter, Setting("Tile background", Group = "Colors", Order = 1, Description = "Default rgba(127,127,127,.06)")] public string? Background { get; set; }
    [Parameter, Setting("Tile border color", Group = "Colors", Order = 2, Description = "Default rgba(127,127,127,.35)")] public string? BorderColor { get; set; }
    [Parameter, Setting("Button background", Group = "Colors", Order = 3, Description = "Default transparent")] public string? ButtonBackground { get; set; }
    [Parameter, Setting("Button border color", Group = "Colors", Order = 4, Description = "Default rgba(127,127,127,.5)")] public string? ButtonBorderColor { get; set; }
    [Parameter, Setting("Button hover background", Group = "Colors", Order = 5, Description = "Default rgba(127,127,127,.18)")] public string? ButtonHoverBackground { get; set; }

    private static readonly JsonSerializerOptions JsonOpts = new() { PropertyNameCaseInsensitive = true };

    private sealed class LaunchConfig
    {
        public string? Url { get; set; }
        public string? Title { get; set; }
        public string? Blurb { get; set; }
        public string? ButtonText { get; set; }
        public string? Mode { get; set; }
        public string? PosterUrl { get; set; }
        public string? PosterUid { get; set; }
        public int? Width { get; set; }
        public int? Height { get; set; }
        public string? Ratio { get; set; }
        public bool? ShowExpand { get; set; }
    }

    private string _url = "#";
    private string _title = "Application";
    private string? _blurb;
    private string _buttonText = "Launch";
    private string _mode = "fullscreen";
    private string? _poster;
    private int _width = 1280;
    private int _height = 800;
    private bool _showExpand = true;
    private string? _ratio;

    protected override void OnParametersSet()
    {
        LaunchConfig? cfg = null;
        if (!string.IsNullOrEmpty(Config))
            try { cfg = JsonSerializer.Deserialize<LaunchConfig>(Config, JsonOpts); } catch { }

        // SafeUrl blocks javascript:/data:/vbscript: — the tile's url is author content, and the
        // whole point of this component is that the value lands in an iframe src.
        _url = SafeUrl(Url ?? cfg?.Url);
        _title = FirstNonEmpty(Title, cfg?.Title) ?? "Application";
        _blurb = FirstNonEmpty(Blurb, cfg?.Blurb);
        _buttonText = FirstNonEmpty(ButtonText, cfg?.ButtonText) ?? "Launch";
        _width = Width ?? cfg?.Width ?? 1280;
        _height = Height ?? cfg?.Height ?? 800;
        _showExpand = ShowExpand ?? cfg?.ShowExpand ?? true;
        _ratio = FirstNonEmpty(Ratio, cfg?.Ratio);

        var mode = (FirstNonEmpty(Mode, cfg?.Mode) ?? "fullscreen").Trim().ToLowerInvariant();
        _mode = mode is "window" or "inline" ? mode : "fullscreen";

        var uid = FirstNonEmpty(PosterUid, cfg?.PosterUid);
        _poster = !string.IsNullOrWhiteSpace(uid)
            ? "/_media/" + uid.Trim()
            : FirstNonEmpty(PosterUrl, cfg?.PosterUrl) is { } p ? SafeUrl(p) : null;
    }

    private static string? FirstNonEmpty(params string?[] values) =>
        values.FirstOrDefault(v => !string.IsNullOrWhiteSpace(v));

    private string _outerStyle => string.Join(";", new[]
    {
        string.IsNullOrEmpty(Padding) ? null : $"padding:{Padding}",
        string.IsNullOrEmpty(Margin)  ? null : $"margin:{Margin}",
        string.IsNullOrEmpty(Align) ? null : $"text-align:{Align}",
        string.IsNullOrEmpty(_ratio) ? null : $"--ma-applaunch-ratio:{_ratio}",
        Var("--ma-applaunch-width", MaxWidth),
        Var("--ma-applaunch-radius", Radius),
        Var("--ma-applaunch-title-size", TitleSize),
        Var("--ma-applaunch-bg", Background),
        Var("--ma-applaunch-line", BorderColor),
        Var("--ma-applaunch-btn-bg", ButtonBackground),
        Var("--ma-applaunch-btn-line", ButtonBorderColor),
        Var("--ma-applaunch-btn-hover", ButtonHoverBackground),
        CssStyle,
    }.Where(s => s is not null));

    private static string? Var(string name, string? value) =>
        string.IsNullOrWhiteSpace(value) ? null : $"{name}:{value}";

    private string? _modClass => Animations ? null : "ma-applaunch--no-anim";
}
