@namespace MindAttic.Ideas.Component.ProjectGrid
@inherits ComponentBase
@attribute [Idea(DisplayName = "Project Grid")]

@*  Renders the CURRENT page's child pages as a card grid, enriched with the repo metadata that
    `--seed repos` snapshots into the "repo" metadata slot (description, language, stars, topics).

    Host-agnostic: it asks the render context for IPageTree and IComponentMetadataStore and degrades to a
    plain link list — then to nothing at all — as those features or that metadata go missing. A page with
    no children renders nothing rather than an empty shell.  *@

<link rel="stylesheet" href="/_ideas/Component/projectgrid/1/projectgrid.css" />

@if (_cards.Count > 0)
{
    <div class="@_rootClass" style="@_outerStyle">
        @if (ShowFilters && _topics.Count > 1)
        {
            <div class="ma-pg-filters" role="tablist" aria-label="@FilterLabel">
                <button type="button" role="tab"
                        class="ma-pg-filter @(_activeTopic is null ? "is-active" : "")"
                        aria-selected="@(_activeTopic is null)"
                        @onclick="() => SetTopic(null)">@AllLabel @if (ShowCounts) {<span class="ma-pg-count">@_cards.Count</span>}</button>
                @foreach (var topic in _topics)
                {
                    var count = _cards.Count(c => c.Topics.Contains(topic));
                    <button type="button" role="tab"
                            class="ma-pg-filter @(_activeTopic == topic ? "is-active" : "")"
                            aria-selected="@(_activeTopic == topic)"
                            @onclick="() => SetTopic(topic)">@topic @if (ShowCounts) {<span class="ma-pg-count">@count</span>}</button>
                }
            </div>
        }

        <ul class="ma-pg-grid">
            @foreach (var card in Visible)
            {
                <li class="ma-pg-card">
                    <a class="ma-pg-link" href="/@card.Slug">
                        <h3 class="ma-pg-title">@card.Title</h3>
                        @if (ShowDescription && !string.IsNullOrWhiteSpace(card.Description))
                        {
                            <p class="ma-pg-desc">@card.Description</p>
                        }
                    </a>
                    <div class="ma-pg-meta">
                        @if (ShowLanguage && !string.IsNullOrWhiteSpace(card.Language))
                        {
                            <span class="ma-pg-lang">@card.Language</span>
                        }
                        @if (ShowStars && card.Stars > 0)
                        {
                            <span class="ma-pg-stars" title="@card.Stars stargazers">★ @card.Stars</span>
                        }
                        @if (ShowLive && !string.IsNullOrWhiteSpace(card.Homepage))
                        {
                            <a class="ma-pg-ext" href="@card.Homepage" target="@_extTarget" rel="noopener noreferrer">@LiveLabel</a>
                        }
                        @if (ShowSource && !string.IsNullOrWhiteSpace(card.Url))
                        {
                            <a class="ma-pg-ext" href="@card.Url" target="@_extTarget" rel="noopener noreferrer">@SourceLabel</a>
                        }
                    </div>
                </li>
            }
        </ul>
    </div>
}

@code {
    /// <summary>
    /// Slug of the page whose children to list, e.g. "projects". Empty = the current page's own children,
    /// which is what an index page wants; a home page pointing at the projects index wants this.
    /// </summary>
    [Parameter, Setting("Parent page slug", Group = "Content", Order = 1, Copyable = false, Description = "Whose child pages to list; blank = this page's children")]
    public string? From { get; set; }

    /// <summary>Show the topic filter bar. Off for a short, unfiltered list.</summary>
    [Parameter, Setting("Show topic filter bar", Group = "Behavior", Order = 1)]
    public bool ShowFilters { get; set; } = true;

    /// <summary>Cap the number of cards rendered (e.g. a "featured" strip on a home page). 0 = no cap.</summary>
    [Parameter, Setting("Max cards", Group = "Behavior", Order = 2, Description = "0 = no cap")]
    public int Max { get; set; }

    /// <summary>Only show cards carrying this GitHub topic. Empty = all.</summary>
    [Parameter, Setting("Only topic", Group = "Behavior", Order = 3, Description = "Only cards carrying this GitHub topic; blank = all")]
    public string? Topic { get; set; }

    /// <summary>
    /// Only show repos whose NAME starts with this, e.g. "MindAttic." for the ecosystem libraries.
    /// Pairs with <see cref="ExcludeNamePrefix"/> to split one topic into two grids.
    /// </summary>
    [Parameter, Setting("Repo name prefix", Group = "Behavior", Order = 4, Description = "Only repos whose name starts with this")]
    public string? NamePrefix { get; set; }

    /// <summary>Hide repos whose name starts with this — the other half of a <see cref="NamePrefix"/> split.</summary>
    [Parameter, Setting("Exclude repo name prefix", Group = "Behavior", Order = 5, Description = "Hide repos whose name starts with this")]
    public string? ExcludeNamePrefix { get; set; }

    [Parameter, Setting("Sort by", Group = "Behavior", Order = 6, Description = "stars (most-starred, then title) | title | none (page order)")]
    public string SortBy { get; set; } = "stars";

    [Parameter, Setting("Show filter counts", Group = "Behavior", Order = 7)] public bool ShowCounts { get; set; } = true;
    [Parameter, Setting("Show description", Group = "Behavior", Order = 8)] public bool ShowDescription { get; set; } = true;
    [Parameter, Setting("Show language", Group = "Behavior", Order = 9)] public bool ShowLanguage { get; set; } = true;
    [Parameter, Setting("Show stars", Group = "Behavior", Order = 10)] public bool ShowStars { get; set; } = true;
    [Parameter, Setting("Show Live link", Group = "Behavior", Order = 11)] public bool ShowLive { get; set; } = true;
    [Parameter, Setting("Show Source link", Group = "Behavior", Order = 12)] public bool ShowSource { get; set; } = true;
    [Parameter, Setting("External links in new tab", Group = "Behavior", Order = 13)] public bool NewTab { get; set; } = true;
    [Parameter, Setting("Hover effects", Group = "Behavior", Order = 14, Description = "Card lift, shadow and transitions")] public bool HoverEffects { get; set; } = true;

    // ── Labels ──────────────────────────────────────────────────────────────────────────────────
    [Parameter, Setting("\"All\" filter label", Group = "Labels", Order = 1)] public string AllLabel { get; set; } = "All";
    [Parameter, Setting("Live link label", Group = "Labels", Order = 2)] public string LiveLabel { get; set; } = "Live";
    [Parameter, Setting("Source link label", Group = "Labels", Order = 3)] public string SourceLabel { get; set; } = "Source";
    [Parameter, Setting("Filter bar label (a11y)", Group = "Labels", Order = 4)] public string FilterLabel { get; set; } = "Filter projects by topic";

    // ── Layout ──────────────────────────────────────────────────────────────────────────────────
    [Parameter, Setting("Columns", Group = "Layout", Order = 1, Description = "0 = auto-fill by minimum card width")] public int Columns { get; set; }
    [Parameter, Setting("Minimum card width", Group = "Layout", Order = 2, Description = "Default 17rem")] public string? MinCardWidth { get; set; }
    [Parameter, Setting("Gap", Group = "Layout", Order = 3, Description = "Default 1.25rem")] public string? Gap { get; set; }
    [Parameter, Setting("Filter bar alignment", Group = "Layout", Order = 4, Description = "flex-start | center | flex-end")] public string? FilterAlign { get; set; }
    [Parameter, Setting("Description lines", Group = "Layout", Order = 5, Description = "Lines before the description is clamped")] public int DescriptionLines { get; set; } = 4;
    [Parameter, Setting("Padding", Group = "Layout", Order = 6)] public string? Padding { get; set; }
    [Parameter, Setting("Margin", Group = "Layout", Order = 7)] public string? Margin { get; set; }

    // ── Colors ──────────────────────────────────────────────────────────────────────────────────
    [Parameter, Setting("Border color", Group = "Colors", Order = 1)] public string? BorderColor { get; set; }
    [Parameter, Setting("Card background", Group = "Colors", Order = 2)] public string? CardBackground { get; set; }
    [Parameter, Setting("Muted text color", Group = "Colors", Order = 3)] public string? MutedColor { get; set; }
    [Parameter, Setting("Accent color", Group = "Colors", Order = 4)] public string? AccentColor { get; set; }
    [Parameter, Setting("Card corner radius", Group = "Colors", Order = 5, Description = "Default .6rem")] public string? Radius { get; set; }
    [Parameter, Setting("Hover shadow", Group = "Colors", Order = 6)] public string? HoverShadow { get; set; }
    [Parameter, Setting("Hover lift", Group = "Colors", Order = 7, Description = "Default -3px")] public string? HoverLift { get; set; }
    [Parameter, Setting("Title font size", Group = "Colors", Order = 8, Description = "Default 1.1rem")] public string? TitleSize { get; set; }

    [Parameter, Setting("Extra CSS classes", Group = "Advanced", Order = 1)] public string? CssClass { get; set; }
    [Parameter, Setting("Extra inline style", Group = "Advanced", Order = 2)] public string? CssStyle { get; set; }

    private string _rootClass => $"ma-projectgrid {(HoverEffects ? null : "ma-pg--no-anim ")}{CssClass}";
    private string? _extTarget => NewTab ? "_blank" : null;

    private static string? Var(string name, string? value) =>
        string.IsNullOrWhiteSpace(value) ? null : $"{name}:{value}";

    private string _outerStyle => string.Join(";", new[]
    {
        Columns > 0 ? $"--ma-pg-cols:repeat({Columns},minmax(0,1fr))" : null,
        Var("--ma-pg-min", MinCardWidth),
        Var("--ma-pg-gap", Gap),
        Var("--ma-pg-filter-align", FilterAlign),
        DescriptionLines != 4 && DescriptionLines > 0 ? $"--ma-pg-desc-lines:{DescriptionLines}" : null,
        Var("--ma-pg-border", BorderColor),
        Var("--ma-pg-card-bg", CardBackground),
        Var("--ma-pg-muted", MutedColor),
        Var("--ma-pg-accent", AccentColor),
        Var("--ma-pg-radius", Radius),
        Var("--ma-pg-hover-shadow", HoverShadow),
        Var("--ma-pg-lift", HoverLift),
        Var("--ma-pg-title-size", TitleSize),
        string.IsNullOrEmpty(Padding) ? null : $"padding:{Padding}",
        string.IsNullOrEmpty(Margin) ? null : $"margin:{Margin}",
        CssStyle,
    }.Where(s => s is not null));

    private List<Card> _cards = [];
    private List<string> _topics = [];
    private string? _activeTopic;

    private IEnumerable<Card> Visible
    {
        get
        {
            var q = _activeTopic is null ? _cards : _cards.Where(c => c.Topics.Contains(_activeTopic));
            return Max > 0 ? q.Take(Max) : q;
        }
    }

    private void SetTopic(string? topic) => _activeTopic = topic;

    protected override async Task OnInitializedAsync()
    {
        if (Context is null) return;
        if (!Context.TryGetFeature<IPageTree>(out var tree) || tree is null) return;

        // From= names another page BY SLUG, and a slug is unique only within a site — pass the site uid
        // so a multi-site deployment cannot answer with a same-slug page from another domain.
        var children = string.IsNullOrWhiteSpace(From)
            ? await tree.ChildrenOfAsync(Context.Page.PageId)
            : await tree.ChildrenOfSlugAsync(Context.Site.SiteId, From!);
        if (children.Count == 0) return;

        // One lookup for the whole list — GetManyAsync exists precisely so an index page isn't N+1.
        IReadOnlyDictionary<Guid, string> meta = new Dictionary<Guid, string>();
        if (Context.TryGetFeature<IComponentMetadataStore>(out var store) && store is not null)
            meta = await store.GetManyAsync(children.Select(c => c.PageId), "repo");

        foreach (var child in children)
        {
            // A child with no repo metadata still gets a card — the page exists, so it belongs in the index.
            var card = new Card { Slug = child.Slug, Title = child.Title };
            if (meta.TryGetValue(child.PageId, out var json)) Apply(card, json);
            _cards.Add(card);
        }

        if (!string.IsNullOrWhiteSpace(Topic))
            _cards = _cards.Where(c => c.Topics.Contains(Topic!, StringComparer.OrdinalIgnoreCase)).ToList();

        // Name filters work on the REPO name, not the page title, so "MindAttic." splits the ecosystem
        // libraries out of the software topic exactly the way the repo names do.
        if (!string.IsNullOrWhiteSpace(NamePrefix))
            _cards = _cards.Where(c => c.Name.StartsWith(NamePrefix!, StringComparison.OrdinalIgnoreCase)).ToList();
        if (!string.IsNullOrWhiteSpace(ExcludeNamePrefix))
            _cards = _cards.Where(c => !c.Name.StartsWith(ExcludeNamePrefix!, StringComparison.OrdinalIgnoreCase)).ToList();

        // Most-starred first, then alphabetical — a portfolio should lead with its strongest work.
        var sort = (SortBy ?? "stars").Trim().ToLowerInvariant();
        if (sort == "title")
            _cards = _cards.OrderBy(c => c.Title, StringComparer.OrdinalIgnoreCase).ToList();
        else if (sort != "none" && sort != "page")
            _cards = _cards.OrderByDescending(c => c.Stars).ThenBy(c => c.Title, StringComparer.OrdinalIgnoreCase).ToList();

        _topics = _cards.SelectMany(c => c.Topics)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(t => t, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    /// <summary>Fold a "repo" metadata blob onto a card. A malformed blob leaves the card as-is.</summary>
    private static void Apply(Card card, string json)
    {
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            var root = doc.RootElement;
            card.Name = Str(root, "name") ?? card.Name;
            card.Description = Str(root, "description") ?? card.Description;
            card.Language = Str(root, "language");
            card.Url = Str(root, "url");
            card.Homepage = Str(root, "homepage");
            if (root.TryGetProperty("stars", out var s) && s.TryGetInt32(out var stars)) card.Stars = stars;
            if (root.TryGetProperty("topics", out var t) && t.ValueKind == System.Text.Json.JsonValueKind.Array)
                card.Topics = t.EnumerateArray()
                    .Select(e => e.GetString())
                    .Where(v => !string.IsNullOrWhiteSpace(v))
                    .Select(v => v!)
                    .ToList();
        }
        catch
        {
            // Metadata is author-editable; a bad blob must not take the index down.
        }
    }

    private static string? Str(System.Text.Json.JsonElement root, string name) =>
        root.TryGetProperty(name, out var v) && v.ValueKind == System.Text.Json.JsonValueKind.String
            ? v.GetString() is { Length: > 0 } s ? s : null
            : null;

    private sealed class Card
    {
        public string Slug { get; set; } = "";
        public string Title { get; set; } = "";
        /// <summary>The GitHub repo name, which the name filters match on.</summary>
        public string Name { get; set; } = "";
        public string? Description { get; set; }
        public string? Language { get; set; }
        public string? Url { get; set; }
        public string? Homepage { get; set; }
        public int Stars { get; set; }
        public List<string> Topics { get; set; } = [];
    }
}
