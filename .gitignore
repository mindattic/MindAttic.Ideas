# Build output
[Bb]in/
[Oo]bj/
[Oo]ut/
artifacts/

# Visual Studio / Rider / VS Code
.vs/
.vscode/
.idea/
*.user
*.suo

# Test results
[Tt]est[Rr]esults/
*.trx

# NuGet
*.nupkg
packages/

# OS / misc
*.log
Thumbs.db
.DS_Store

# Secrets never live in the repo â€” auth/dev secrets are in %APPDATA%\MindAttic\ (Vault).
# Defensive: a stray .env must never be stageable. (The auth design uses NO .env.)
.env
*.env
.claude/quicksave.md

# The vendored MindAttic package feed IS tracked: GitHub-hosted CI has no C:\LocalNuGet
# and no ../local-feed, so these are the only copies a Release restore can see.
!lib/local-packages/*.nupkg

# `dotnet publish -o publish` output. A deployment artifact, never source.
publish/

# The LOCAL media store: uploaded screenshots, diagrams and page assets the dev host writes at
# runtime. Content belongs in the database and travels as a .ideabundle (MAI-A34), never in git.
src/MindAttic.Ideas.Blazor/media/
