<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- Vendored, git-tracked copies of every MindAttic.* package this repo references. This is the
         ONLY source a GitHub-hosted runner can see: it has no C:\LocalNuGet and no ../local-feed.
         Listed first so a dev box and CI resolve identically. When you bump a MindAttic package,
         drop the new .nupkg here AND update the PackageReference - see docs/DEPLOYMENT.md. -->
    <add key="local-packages" value="./lib/local-packages" />
    <!-- Dev-box feeds. A missing local source is tolerated by NuGet, so these are simply inert in CI. -->
    <add key="LocalNuGet" value="C:\LocalNuGet" />
    <!-- MindAttic.Ideas .idea citizens packed as RCL NuGets (e.g. the MindAtticFrontpage Page). -->
    <add key="IdeasFeed" value="..\local-feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
